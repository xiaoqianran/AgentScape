{
  "name": "agentscape",
  "version": "1.34.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run architecture:validate && npm run assets:validate && npm run test && npm run build",
    "architecture:validate": "node tools/validate-repository-architecture.mjs && node tools/validate-domain-boundaries.mjs",
    "assets:validate": "node tools/validate-assets.mjs",
    "agent:gateway": "node scripts/openai-compatible-agent-gateway.mjs",
    "agent:probe": "node scripts/probe-test-agent.mjs",
    "test:asset": "vitest run tests/artifact-*.test.js tests/asset-*.test.js tests/compiled-asset-store.test.js tests/verified-artifact-asset-pipeline.test.js",
    "test:world": "vitest run tests/world-*.test.js tests/bootstrap-world.test.js tests/interaction-*.test.js tests/rule-runtime.test.js",
    "experiment:asset": "node experiments/asset/001-real-glb-admission.mjs",
    "experiment:world": "node experiments/world/001-existing-assets-world.mjs",
    "repos:audit": "bash scripts/repos.sh audit",
    "repos:sync-safe": "bash scripts/repos.sh sync-safe",
    "repos:status": "bash scripts/repos.sh status",
    "repos:check": "bash scripts/repos.sh check",
    "repos:check-recursive": "bash scripts/repos.sh check-recursive"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@recast-navigation/core": "^0.43.1",
    "@recast-navigation/generators": "^0.43.1",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.9.1"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
