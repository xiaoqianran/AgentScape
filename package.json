{
  "name": "agentscape",
  "version": "2.0.0-dev.1",
  "private": true,
  "type": "module",
  "scripts": {
    "starter": "vite --open /starter/",
    "test:starter": "vitest run tests/integration/starter-scene.test.js",
    "test:browser:starter": "playwright test tests/browser/starter.spec.js",
    "dev": "vite",
    "generate:world-previews": "node dev/generate-world-previews.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test": "vitest run --exclude tests/e2e/generated-cup-runtime-e2e.test.js",
    "test:watch": "vitest",
    "check": "npm run architecture:validate && npm run assets:validate && npm run world:viability && npm run typecheck && npm run test && npm run build",
    "architecture:validate": "node dev/validate-repository-architecture.mjs && node dev/validate-domain-boundaries.mjs && node dev/validate-convergence.mjs && npm run planning:validate",
    "planning:validate": "node dev/planning.mjs",
    "planning:list": "node dev/planning.mjs --json",
    "planning:ready": "node dev/planning.mjs --ready --json",
    "assets:validate": "node dev/validate-assets.mjs",
    "agent:gateway": "node apps/server/openai-compatible-agent-gateway.mjs",
    "agent:probe": "node dev/scripts/probe-test-agent.mjs",
    "test:asset": "vitest run tests/asset tests/integration/asset-production-pipeline.test.js",
    "test:world": "vitest run tests/world tests/e2e --exclude tests/e2e/generated-cup-runtime-e2e.test.js",
    "test:native-heavyworld": "vitest run tests/integration/native-heavyworld-acceptance.test.js tests/integration/world-preparation-cleanup.test.js tests/integration/world-storage.test.js",
    "experiment:asset": "node dev/experiments/asset/001-real-glb-admission.mjs",
    "experiment:world": "node dev/experiments/world/001-existing-assets-world.mjs",
    "experiment:physics": "node dev/experiments/physics/002-physics-api-harness.mjs",
    "physics:check": "node dev/experiments/physics/002-physics-api-harness.mjs",
    "world:viability": "node dev/experiments/world/002-world-viability.mjs",
    "acceptance:world": "node dev/acceptance/cabinetCup.mjs",
    "test:agent": "vitest run tests/agent tests/e2e/agent-*",
    "test:generation": "vitest run tests/generation tests/contracts tests/studio/generation-job-center-*",
    "test:modal-e2e": "vitest run tests/e2e/generated-cup-runtime-e2e.test.js",
    "test:studio": "vitest run tests/studio",
    "test:observatory": "vitest run tests/observatory",
    "typecheck": "tsc --noEmit && tsc -p sdk/typescript/tsconfig.json",
    "test:artifact": "vitest run tests/artifact",
    "test:browser": "playwright test",
    "mcp:serve": "node apps/mcp-server/main.mjs",
    "test:mcp": "vitest run tests/mcp",
    "sdk:verify": "node dev/verify-sdk-install.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@recast-navigation/core": "^0.43.1",
    "@recast-navigation/generators": "^0.43.1",
    "@sparkjsdev/spark": "~2.1.0",
    "es-module-lexer": "^2.3.2",
    "jolt-physics": "1.1.0",
    "quickjs-emscripten": "0.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rolldown": "1.2.8",
    "sharp": "0.35.5",
    "three": "0.186.0",
    "three-gsmesh": "^0.0.3",
    "three-mesh-bvh": "^0.9.1",
    "zod": "4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "10.6.5",
    "@storybook/addon-mcp": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "storybook": "10.6.5",
    "typescript": "^7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.3"
  },
  "overrides": {
    "glob": "14.0.3",
    "minimatch": "11.0.4"
  }
}
