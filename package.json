{
  "name": "agentscape",
  "version": "1.34.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run --exclude tests/e2e/generated-cup-runtime-e2e.test.js",
    "test:watch": "vitest",
    "check": "npm run architecture:validate && npm run assets:validate && npm run world:viability && npm run typecheck && npm run test && npm run build",
    "architecture:validate": "node tooling/validate-repository-architecture.mjs && node tooling/validate-domain-boundaries.mjs && node tooling/validate-convergence.mjs",
    "assets:validate": "node tooling/validate-assets.mjs",
    "agent:gateway": "node tooling/scripts/openai-compatible-agent-gateway.mjs",
    "agent:probe": "node tooling/scripts/probe-test-agent.mjs",
    "test:asset": "vitest run tests/asset tests/integration/verified-artifact-asset-pipeline.test.js",
    "test:world": "vitest run tests/world tests/e2e --exclude tests/e2e/generated-cup-runtime-e2e.test.js",
    "experiment:asset": "node tooling/experiments/asset/001-real-glb-admission.mjs",
    "experiment:world": "node tooling/experiments/world/001-existing-assets-world.mjs",
    "world:viability": "node tooling/experiments/world/002-world-viability.mjs",
    "test:agent": "vitest run tests/agent tests/e2e/agent-*",
    "test:generation": "vitest run tests/generation tests/contracts tests/studio/generation-job-center-*",
    "test:modal-e2e": "vitest run tests/e2e/generated-cup-runtime-e2e.test.js",
    "test:studio": "vitest run tests/studio",
    "test:observatory": "vitest run tests/observatory",
    "typecheck": "tsc --noEmit",
    "test:artifact": "vitest run tests/artifact"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@recast-navigation/core": "^0.43.1",
    "@recast-navigation/generators": "^0.43.1",
    "@sparkjsdev/spark": "^2.1.0",
    "jolt-physics": "1.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "three-gsmesh": "^0.0.3",
    "three-mesh-bvh": "^0.9.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "sharp": "^0.35.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
