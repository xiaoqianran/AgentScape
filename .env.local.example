# Local/VPS only. Never commit a real API key.
AGENTSCAPE_TEST_LLM_BASE_URL=https://nim.202820.xyz/v1
AGENTSCAPE_TEST_LLM_API_KEY=replace-me
AGENTSCAPE_TEST_LLM_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# Alternate model tested successfully:
# AGENTSCAPE_TEST_LLM_MODEL=meta/muse-glimmer-30b
AGENTSCAPE_TEST_LLM_HOST=127.0.0.1
AGENTSCAPE_TEST_LLM_PORT=8788
# Optional extra browser origins. Localhost / 127.0.0.1 are allowed by default.
AGENTSCAPE_TEST_LLM_ALLOWED_ORIGINS=
# Optional: print model planning/tool trace during live probes.
AGENTSCAPE_TEST_LLM_TRACE=0

# AgentScape deployment adapters. These implementation details stay server-side.
AGENT_ADAPTER_URL=https://agent-adapter.example/complete
AGENT_ADAPTER_AUTHORIZATION=Bearer replace-me
ASSET_COMPILE_ADAPTER_URL=https://asset-compile-adapter.example/compile
ASSET_COMPILE_ADAPTER_AUTHORIZATION=Bearer replace-me
ASSET_GENERATE_ADAPTER_URL=https://asset-generate-adapter.example/generate
ASSET_GENERATE_ADAPTER_AUTHORIZATION=Bearer replace-me
