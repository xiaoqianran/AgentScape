{
  "name": "agentscape3d",
  "version": "1.0.0-beta.1",
  "type": "module",
  "description": "AgentScape 3D world engine, SDK, CLI and local MCP server",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "node": "./dist/node.js",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    }
  },
  "bin": {
    "agentscape": "./cli.mjs",
    "agentscape3d": "./cli.mjs"
  },
  "files": [
    "dist",
    "site",
    "cli.mjs",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node ../../dev/build-sdk.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.2-rc.5",
    "@deepseek-ai/dsh-mcp-client": "0.2.2-rc.5",
    "@deepseek-ai/dsh-sdk-client": "0.2.2-rc.5",
    "@dimforge/rapier3d-compat": "^0.21.0",
    "@earendil-works/pi-agent-core": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-mcp": "1.5.2",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@recast-navigation/core": "^0.44.0",
    "@recast-navigation/generators": "^0.44.0",
    "@sparkjsdev/spark": "~2.1.0",
    "es-module-lexer": "^2.3.2",
    "jolt-physics": "1.1.1",
    "quickjs-emscripten": "0.32.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rolldown": "1.3.2",
    "sharp": "0.35.5",
    "three-gsmesh": "^0.0.3",
    "three-mesh-bvh": "^0.9.18",
    "zod": "4.6.7",
    "zustand": "^5.1.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "peerDependencies": {
    "three": "^0.187.0"
  }
}
