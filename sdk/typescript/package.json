{
  "name": "agentscape3d",
  "version": "2.0.0-beta.1",
  "type": "module",
  "description": "AgentScape 3D world engine, SDK, CLI and local MCP server",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/index.js",
      "node": "./dist/node.js",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "import": "./dist/mcp.js"
    }
  },
  "bin": {
    "agentscape": "./cli.mjs"
  },
  "files": [
    "dist",
    "cli.mjs",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node ../../dev/build-sdk.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@recast-navigation/core": "^0.43.1",
    "@recast-navigation/generators": "^0.43.1",
    "@sparkjsdev/spark": "~2.1.0",
    "jolt-physics": "1.1.0",
    "quickjs-emscripten": "0.32.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rolldown": "1.2.8",
    "sharp": "0.35.5",
    "three": "0.186.0",
    "three-gsmesh": "^0.0.3",
    "three-mesh-bvh": "^0.9.1",
    "zod": "4.6.7",
    "zustand": "^5.0.15"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  }
}
