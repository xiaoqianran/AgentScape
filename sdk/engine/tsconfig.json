{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "allowJs": true,
    "checkJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true
  },
  "include": [
    "src/index.ts",
    "src/index.d.ts",
    "src/node.d.ts",
    "src/mcp.d.ts",
    "src/core.d.ts"
  ]
}
